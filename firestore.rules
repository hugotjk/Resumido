rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function
    function isValidTimestamp(ts) {
      return ts is string || ts is timestamp;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if true;
    }

    // Certificates collection
    match /certificates/{certId} {
      allow read: if true;
      allow write: if true;
    }

    // Faturamento reports cache
    match /faturamento_reports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    // Products catalog
    match /pdv_products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Fiscal events (Cartas de Correção, Cancelamentos, Manifestações)
    match /fiscal_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // SEFAZ NSU sync state tracking
    match /sefaz_sync_state/{stateId} {
      allow read: if true;
      allow write: if true;
    }

    // System configuration (MKP rules, general settings)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
